	column Severity = SWITCH([ppmf_severity], 1,"Info", 2,"Warning", 3,"Critical", "Unknown")
		lineageTag: b21eca06-8339-440c-8aff-a69b3f5d02e8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Triage Status' = SWITCH([ppmf_triagestatus], 1,"New", 2,"In Progress", 3,"Fixed", 4,"Duplicate", 5,"Won't Fix", 6,"Awaiting Info", 7,"Closed", "Unknown")
		lineageTag: ffec5b18-ccf5-4936-ba17-43401b57820e
