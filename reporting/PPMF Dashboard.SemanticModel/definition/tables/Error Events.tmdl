table 'Error Events'
	lineageTag: bebdaa97-310d-4ad3-b415-c8cd3d7071b3

	measure 'Total Errors' = COUNTROWS('Error Events')
		formatString: 0
		lineageTag: 0b7a0dba-550b-47e3-b43e-af86808d6c01

	measure 'Open Errors' = CALCULATE([Total Errors], 'Error Events'[Is Open])
		formatString: 0
		lineageTag: e8c65933-27fc-427a-aebe-5405d654e1c7

	measure 'Critical Errors' = CALCULATE([Total Errors], 'Error Events'[Is Critical])
		formatString: 0
		lineageTag: 76d908f3-8b23-47c5-8040-453b6466f57c

	measure 'Open Critical' = CALCULATE([Critical Errors], 'Error Events'[Is Open])
		formatString: 0
		lineageTag: 5df265a9-494e-42ea-91fd-1dd63580bf73

	measure 'Resolution Rate' = DIVIDE(CALCULATE([Total Errors], 'Error Events'[ppmf_triagestatus] = 3), [Total Errors])
		lineageTag: 7e8497db-9807-45a4-a6c5-604f239ad02b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Days To Resolve' =
			
			COALESCE(
			    AVERAGEX(
			        FILTER('Error Events', NOT(ISBLANK('Error Events'[Fixed On]))),
			        'Error Events'[Days To Resolve]
			    ),
			    LASTNONBLANKVALUE(
			        'Date'[Year-Month],
			        AVERAGEX(
			            FILTER('Error Events', NOT(ISBLANK('Error Events'[Fixed On]))),
			            'Error Events'[Days To Resolve]
			        )
			    )
			)
		lineageTag: 9149db39-e043-4b86-9ace-969a92361e4f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

