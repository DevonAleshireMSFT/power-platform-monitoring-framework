        "Environment Name (ppmf_EnvironmentName)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "ppmf_EnvironmentName",
            "description": "A short, human-readable label that identifies this Power Platform environment in Teams alerts and on every error record. Use a clear, consistent name such as \"Production\", \"UAT\", or \"Dev\". This value is displayed in the subject line of every alert message posted to Teams, making it immediately clear which environment generated the error."
          }
        },
        "Team ID (ppmf_TeamID)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "ppmf_TeamID",
            "description": "The Azure AD group ID (GUID) of the Microsoft Teams team where flow failure alerts will be posted by default. Every Microsoft Team is backed by a Microsoft 365 Group; this value is the Object ID of that group. Find it in Teams Admin Center under the team details, or from the team URL in the Teams client (the groupId query parameter). Used as the fallback destination when no Alert Route matches an incoming error."
          }
        },
        "Flow Alerts Channel ID (ppmf_FlowAlertsChannelID)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "ppmf_FlowAlertsChannelID",
            "description": "The Teams channel ID of the default channel where flow failure alert messages will be posted. This is the internal channel identifier starting with \"19:\" — visible in the channel URL after /channel/ in the Teams web or desktop client (URL-decode %3A to : and %40 to @). Used as the fallback destination when no Alert Route matches an incoming error. Add Alert Route records to route specific solutions to different channels."
          }
        }
      },
