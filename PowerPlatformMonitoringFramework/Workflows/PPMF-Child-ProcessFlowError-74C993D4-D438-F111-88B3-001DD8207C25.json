{
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Portal Base URL (ppmf_PortalBaseUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "ppmf_PortalBaseUrl",
            "description": "The base URL of the Power Automate portal for this cloud environment. Used to construct direct deep links to failed flow runs inside Teams alert messages. Set to the correct endpoint for your cloud: Commercial — https://make.powerautomate.com, GCC High — https://make.powerautomate.appsplatform.us, DoD — https://make.powerautomate.appsplatform.mil. Do not include a trailing slash."
          }
        },
        "Writing Mode (ppmf_WritingMode)": {
          "defaultValue": "Dataverse",
          "type": "String",
          "metadata": {
            "schemaName": "ppmf_WritingMode",
            "description": "Controls where error events are written. Dataverse — writes only to Dataverse (default). SharePoint — writes only to SharePoint (use in environments without Dataverse). Both — writes to both simultaneously. Accepted values: Dataverse, SharePoint, Both."
          }
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "b48b2381-1113-4bef-b41b-b2f426927554"
          },
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "SolutionName",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Name of solution",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "ParentWorkFlowJson",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "work flow information",
                  "x-ms-content-hint": "TEXT"
                },
                "text_2": {
                  "title": "TryResultsJson",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "JSON Try  results",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text",
                "text_1",
                "text_2"
              ]
            }
          }
        }
      },
      "actions": {
        "Initialize_variable_PortalBase_URL": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "4849b26d-5e85-4f88-95d2-6553d1dcadf9"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "PortalBaseUrl",
                "type": "string",
                "value": "@parameters('Portal Base URL (ppmf_PortalBaseUrl)')"
              }
            ]
          }
        },
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "Switch_WritingMode": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "ec2cb127-4908-49b6-8a98-c19ab6c49c59"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "title": "Success",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "success": "@{variables('varSuccess')}"
            }
          }
        },
        "Parse_JSON": {
          "runAfter": {
            "Initialize_variable_Success": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "366c0018-b84d-4f6a-abb4-a01e0d9bdfb5"
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@triggerBody()['text_1']",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "tags": {
                  "type": "object",
                  "properties": {
                    "flowDisplayName": {
                      "type": "string"
                    },
                    "environmentName": {
                      "type": "string"
                    },
                    "logicAppName": {
                      "type": "string"
                    },
                    "environmentWorkflowId": {
                      "type": "string"
                    },
                    "xrmWorkflowId": {
                      "type": "string"
                    },
                    "environmentFlowSuspensionReason": {
                      "type": "string"
                    },
                    "sharingType": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    },
                    "createdTime": {
                      "type": "string"
                    },
                    "lastModifiedTime": {
                      "type": "string"
                    },
                    "createdBy": {
                      "type": "string"
                    },
                    "triggerType": {
                      "type": "string"
                    }
                  }
                },
                "run": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "Filter_array": {
          "runAfter": {
            "Parse_JSON_Try_Results": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "b88fc5ab-dcf0-4656-be87-493b71e4929b"
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Parse_JSON_Try_Results')",
            "where": "@or(equals(item()?['status'], 'Failed'), equals(item()?['status'], 'TimedOut'))"
          }
        },
        "Compose_First_failed_action": {
          "runAfter": {
            "Filter_array": [
              "Succeeded"
