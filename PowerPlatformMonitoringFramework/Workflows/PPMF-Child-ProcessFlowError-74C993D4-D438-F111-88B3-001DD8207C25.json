                        "type": "none"
                      }
                    }
                  },
                  "Set_variable": {
                    "runAfter": {
                      "Run_a_Child_Flow": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "d892cb1f-370a-41c4-b9c4-5a423199003c"
                    },
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varSuccess",
                      "value": "@true"
                    }
                  }
                }
              }
            }
          }
        }
