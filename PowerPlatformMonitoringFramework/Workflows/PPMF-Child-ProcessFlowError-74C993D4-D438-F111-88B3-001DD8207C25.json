          },
          "metadata": {
            "operationMetadataId": "f539287b-e4a3-4220-96dd-29d4818cb64c"
          },
          "type": "Compose",
          "inputs": "@first(body('Filter_array'))"
        },
        "Compose_Failed_action_message": {
          "runAfter": {
            "Compose_First_failed_action": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "bc74bdcc-92eb-47c5-b596-0769e5e43e51"
          },
          "type": "Compose",
          "inputs": "@coalesce(outputs('Compose_First_failed_action')?['outputs']?['body']?['error']?['message'], outputs('Compose_First_failed_action')?['error']?['message'], 'Unknown error')"
        },
        "Parse_JSON_Try_Results": {
          "runAfter": {
            "Parse_JSON": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "aa304fb3-7b71-44c3-a021-e2470d5206b9"
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@triggerBody()['text_2']",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "startTime": {
                    "type": "string"
                  },
                  "endTime": {
                    "type": "string"
                  },
                  "trackingId": {
                    "type": "string"
                  },
                  "clientTrackingId": {
                    "type": "string"
                  },
                  "clientKeywords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "code": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "error": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                },
                "required": [
                  "name",
                  "startTime",
                  "endTime",
                  "trackingId",
                  "clientTrackingId",
                  "code",
                  "status"
                ]
              }
            }
          }
        },
        "Compose_ErrorPayload": {
          "runAfter": {
            "Compose_Failed_action_message": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "da56a659-cffd-4c7b-99b2-71c016a073ff"
          },
          "type": "Compose",
          "inputs": "@json(\r\n  concat(\r\n    '{',\r\n      '\"timestamp\":\"', utcNow(), '\",',\r\n      '\"flow\":{',\r\n        '\"name\":\"', body('Parse_JSON')?['tags']?['flowDisplayName'], '\",',\r\n        '\"Id\":\"', body('Parse_JSON')?['run']?['name'], '\",',\r\n        '\"Url\":\"', concat(\r\n          variables('PortalBaseUrl'),\r\n          '/environments/',\r\n          body('Parse_JSON')?['tags']?['environmentName'],\r\n          '/flows/',\r\n          body('Parse_JSON')?['name'],\r\n          '/runs/',\r\n          body('Parse_JSON')?['run']?['name']\r\n        ), '\"',\r\n      '},',\r\n      '\"primaryErrorMessage\":\"', replace(outputs('Compose_Failed_action_message'), '\"', '\\\"'), '\",',\r\n      '\"error\":', string(body('Filter_array')),\r\n    '}'\r\n  )\r\n)"
        },
        "Initialize_variable_Success": {
          "runAfter": {
            "Initialize_variable_PortalBase_URL": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "7c73203c-4bcb-4565-933b-9d1e5206611d"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varSuccess",
                "type": "boolean",
                "value": "@false"
              }
            ]
          }
        },
        "Switch_WritingMode": {
          "runAfter": {
            "Compose_ErrorPayload": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "aa110005-cc22-f111-bb33-001dd8100005"
          },
          "type": "Switch",
          "expression": "@parameters('Writing Mode (ppmf_WritingMode)')",
          "cases": {
            "CaseSharePoint": {
              "case": "SharePoint",
              "actions": {
                "Scope-Record_Error_SharePoint": {
                  "metadata": {
                    "operationMetadataId": "aa110005-cc22-f111-bb33-001dd8100006"
                  },
                  "type": "Scope",
                  "actions": {
                    "Run_FlowErrorHandler_SharePoint": {
                      "metadata": {
                        "operationMetadataId": "aa110005-cc22-f111-bb33-001dd8100007"
                      },
                      "type": "Workflow",
                      "inputs": {
                        "host": {
                          "workflowReferenceName": "aa110002-cc22-f111-bb33-001dd8100002"
                        },
                        "body": {
                          "text_3": "@string(outputs('Compose_ErrorPayload'))",
                          "text": "@triggerBody()['text']",
                          "text_1": "false"
                        },
                        "retryPolicy": {
                          "type": "none"
                        }
                      }
                    },
                    "Set_variable_SharePoint": {
                      "runAfter": {
                        "Run_FlowErrorHandler_SharePoint": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "aa110005-cc22-f111-bb33-001dd8100008"
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "varSuccess",
                        "value": "@true"
                      }
                    }
                  }
                }
              }
            },
            "CaseBoth": {
              "case": "Both",
              "actions": {
                "Scope-Record_Error_Dataverse_Both": {
                  "metadata": {
                    "operationMetadataId": "aa110005-cc22-f111-bb33-001dd8100009"
                  },
                  "type": "Scope",
                  "actions": {
                    "Run_a_Child_Flow_Dataverse_Both": {
                      "metadata": {
                        "operationMetadataId": "aa110005-cc22-f111-bb33-001dd810000a"
                      },
                      "type": "Workflow",
                      "inputs": {
                        "host": {
                          "workflowReferenceName": "d3f874c5-271f-f111-8341-001dd808cec5"
                        },
                        "body": {
                          "text_3": "@string(outputs('Compose_ErrorPayload'))",
                          "text": "@triggerBody()['text']"
                        },
                        "retryPolicy": {
                          "type": "none"
                        }
                      }
                    },
                    "Set_variable_Both_Dataverse": {
                      "runAfter": {
                        "Run_a_Child_Flow_Dataverse_Both": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "aa110005-cc22-f111-bb33-001dd810000b"
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "varSuccess",
                        "value": "@true"
                      }
                    }
                  }
                },
                "Scope-Record_Error_SharePoint_Both": {
                  "runAfter": {
                    "Scope-Record_Error_Dataverse_Both": [
                      "Succeeded",
                      "Failed",
                      "Skipped",
                      "TimedOut"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "aa110005-cc22-f111-bb33-001dd810000c"
                  },
                  "type": "Scope",
                  "actions": {
                    "Run_FlowErrorHandler_SharePoint_Both": {
                      "metadata": {
                        "operationMetadataId": "aa110005-cc22-f111-bb33-001dd810000d"
                      },
                      "type": "Workflow",
                      "inputs": {
                        "host": {
                          "workflowReferenceName": "aa110002-cc22-f111-bb33-001dd8100002"
                        },
                        "body": {
                          "text_3": "@string(outputs('Compose_ErrorPayload'))",
                          "text": "@triggerBody()['text']",
                          "text_1": "true"
                        },
                        "retryPolicy": {
                          "type": "none"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "actions": {
              "Scope-Record_Error": {
                "metadata": {
                  "operationMetadataId": "ead8f8e3-21d0-44b7-a605-c22e36c5a97d"
                },
                "type": "Scope",
                "actions": {
                  "Run_a_Child_Flow": {
                    "metadata": {
                      "operationMetadataId": "84d61202-9912-4c09-a95b-128bf59d831b"
                    },
                    "type": "Workflow",
                    "inputs": {
                      "host": {
                        "workflowReferenceName": "d3f874c5-271f-f111-8341-001dd808cec5"
                      },
                      "body": {
                        "text_3": "@string(outputs('Compose_ErrorPayload'))",
                        "text": "@triggerBody()['text']"
                      },
