<?xml version="1.0" encoding="utf-8"?>
<Role id="{59d46f28-1e45-f111-bec5-001dd802d907}" name="PPMF - Triager" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <IsCustomizable>1</IsCustomizable>
  <IsAutoAssigned>0</IsAutoAssigned>
  <AppliesTo>Users and TEams</AppliesTo>
  <Description>Grants read and write access to Error Events and Error Notes for active triage work. Assign to support analysts and developers responsible for investigating, updating, and resolving errors. Cannot modify Alert Routes.</Description>
  <SummaryOfCoreTablePermissions>ppmf_ErrorEvent: Read/Write (Org), Append To (Org). ppmf_ErrorNote: Create/Read/Write/Delete/Append (User), Read (Org). ppmf_AlertRoute: Read (Org) only. No create, write, or delete on Alert Routes.</SummaryOfCoreTablePermissions>
  <RolePrivileges>
