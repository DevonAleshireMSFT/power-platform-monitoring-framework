        <small>Run the New-PPMFTables.ps1 provisioning script if the table does not exist yet.</small>
      </div>`;
  }
}

async function toggleRoute(id, newState) {
  try {
    await dvPatch(`ppmf_alertroutes(${id})`, { ppmf_isactive: newState });
    showToast(`Route ${newState ? 'enabled' : 'disabled'}`, 'success');
    loadAlertRoutes();
    loadChecklist();
  } catch (e) {
    showToast('Update failed: ' + e.message, 'error');
  }
}

async function deleteRoute(id, name) {
  if (!confirm(`Delete alert route "${name}"?\n\nThis action cannot be undone.`)) return;
  try {
    await dvDelete(`ppmf_alertroutes(${id})`);
    showToast(`Route "${name}" deleted`, 'success');
    loadAlertRoutes();
    loadChecklist();
  } catch (e) {
    showToast('Delete failed: ' + e.message, 'error');
  }
}

function toggleAddRoutePanel() {
  const panel = document.getElementById('add-route-panel');
  panel.classList.toggle('visible');
  if (panel.classList.contains('visible')) {
    document.getElementById('nr-name').focus();
  }
}

async function createAlertRoute() {
  const name      = document.getElementById('nr-name').value.trim();
  const pattern   = document.getElementById('nr-pattern').value.trim();
  const severity  = parseInt(document.getElementById('nr-severity').value, 10);
  const teamId    = document.getElementById('nr-teamid').value.trim();
  const channelId = document.getElementById('nr-channelid').value.trim();
  const desc      = document.getElementById('nr-desc').value.trim();

  if (!name)      { showToast('Route Name is required', 'error'); document.getElementById('nr-name').focus();      return; }
  if (!teamId)    { showToast('Teams Group ID is required', 'error'); document.getElementById('nr-teamid').focus();   return; }
  if (!channelId) { showToast('Teams Channel ID is required', 'error'); document.getElementById('nr-channelid').focus(); return; }

  const body = {
    ppmf_name:      name,
    ppmf_minseverity: severity,
    ppmf_teamid:    teamId,
    ppmf_channelid: channelId,
    ppmf_isactive:  true
  };
  if (pattern) body.ppmf_solutionnamepattern = pattern;
  if (desc)    body.ppmf_description         = desc;

  try {
    await dvPost('ppmf_alertroutes', body);
    showToast(`Route "${name}" created`, 'success');
    // Clear the form
    ['nr-name', 'nr-pattern', 'nr-teamid', 'nr-channelid', 'nr-desc']
      .forEach(id => { document.getElementById(id).value = ''; });
    document.getElementById('nr-severity').value = '2';
    toggleAddRoutePanel();
    loadAlertRoutes();
    loadChecklist();
  } catch (e) {
    showToast('Create failed: ' + e.message, 'error');
  }
}

// ─── Utilities ────────────────────────────────────────────────────────────────

function escHtml(str) {
  return String(str)
    .replace(/&/g,  '&amp;')
    .replace(/</g,  '&lt;')
    .replace(/>/g,  '&gt;')
    .replace(/"/g,  '&quot;')
    .replace(/'/g,  '&#39;');
}

function truncate(str, len) {
  return str.length > len ? str.substring(0, len) + '…' : str;
}

function showToast(message, type = '') {
  const container = document.getElementById('toast-container');
  const el        = document.createElement('div');
  el.className    = `toast ${type}`;
  const icon      = type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ';
  el.innerHTML    = `<span>${icon}</span><span>${escHtml(message)}</span>`;
  container.appendChild(el);
  setTimeout(() => {
    el.style.transition = 'opacity .3s';
    el.style.opacity    = '0';
    setTimeout(() => el.remove(), 320);
  }, 3800);
}

// ─── Initialise ───────────────────────────────────────────────────────────────

(async function init() {
  try {
    await loadEnvVars();
    await Promise.all([
      loadChecklist(),
      loadAlertRoutes()
    ]);
  } catch (e) {
    showToast('Initialisation error: ' + e.message, 'error');
  }
}());
</script>

