<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Power Platform Monitoring Framework — Documentation</title>
  <style>
    :root {
      --primary:          #0078d4;
      --primary-dark:     #005a9e;
      --primary-light:    #e1effa;
      --success:          #107c10;
      --success-light:    #f0faf0;
      --success-border:   #c3e6c3;
      --warning-light:    #fffbee;
      --warning-border:   #fde7a0;
      --error:            #d13438;
      --error-light:      #fff3f3;
      --error-border:     #f3c6c7;
      --bg:               #f3f2f1;
      --surface:          #ffffff;
      --border:           #edebe9;
      --border-strong:    #8a8886;
      --text:             #323130;
      --text-secondary:   #605e5c;
      --text-disabled:    #a19f9d;
      --radius:           4px;
      --shadow:           0 1.6px 3.6px rgba(0,0,0,.13), 0 .3px .9px rgba(0,0,0,.11);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      font-size: 14px;
      line-height: 1.6;
      color: var(--text);
      background: var(--bg);
      min-height: 100vh;
    }

    /* ── Header ─────────────────────────────────────────────────────────── */
    .app-header {
      background: var(--primary);
      color: #fff;
      padding: 18px 32px;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .app-header-icon {
      width: 40px; height: 40px;
      background: rgba(255,255,255,.18);
      border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
    }
    .app-header h1 { font-size: 18px; font-weight: 600; }
    .app-header p  { font-size: 12px; opacity: .85; margin-top: 2px; }

    /* ── Layout ──────────────────────────────────────────────────────────── */
    .app-body { display: flex; min-height: calc(100vh - 76px); }

    .sidebar {
      width: 220px;
      flex-shrink: 0;
      background: var(--surface);
      border-right: 1px solid var(--border);
      padding: 20px 0;
      position: sticky;
      top: 0;
      height: calc(100vh - 76px);
      overflow-y: auto;
    }

    .sidebar-section-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--text-disabled);
      padding: 12px 20px 4px;
    }
    .sidebar-section-label:first-child { padding-top: 4px; }

    .sidebar a {
      display: block;
      padding: 7px 20px;
      font-size: 13px;
      color: var(--text-secondary);
      text-decoration: none;
      border-left: 3px solid transparent;
      transition: color .1s, background .1s, border-color .1s;
    }
    .sidebar a:hover { color: var(--primary); background: var(--primary-light); }
    .sidebar a.active { color: var(--primary); border-left-color: var(--primary); background: var(--primary-light); font-weight: 600; }

    .app-main { flex: 1; padding: 28px 36px; max-width: 860px; overflow-y: auto; }

    /* ── Cards ───────────────────────────────────────────────────────────── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      margin-bottom: 24px;
    }
    .card-header {
      padding: 14px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .card-header-icon { font-size: 18px; }
    .card-title    { font-size: 14px; font-weight: 600; }
    .card-subtitle { font-size: 12px; color: var(--text-secondary); margin-top: 1px; }
    .card-body { padding: 20px; }

    /* ── Prose ───────────────────────────────────────────────────────────── */
    .prose p  { margin-bottom: 12px; font-size: 13px; color: var(--text-secondary); }
    .prose p:last-child { margin-bottom: 0; }
    .prose strong { color: var(--text); }

    /* ── Section anchors ─────────────────────────────────────────────────── */
    .doc-section { scroll-margin-top: 20px; }

    /* ── Quick Start steps ───────────────────────────────────────────────── */
    .steps { display: flex; flex-direction: column; gap: 12px; }
    .step {
      display: flex; gap: 16px; align-items: flex-start;
      padding: 14px 16px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    .step-num {
      width: 28px; height: 28px; flex-shrink: 0;
      background: var(--primary); color: #fff;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 700;
    }
    .step-content { flex: 1; }
    .step-title { font-weight: 600; font-size: 13px; margin-bottom: 3px; }
    .step-desc  { font-size: 12px; color: var(--text-secondary); }
    .step.done { background: var(--success-light); border-color: var(--success-border); }
    .step.done .step-num { background: var(--success); }

    /* ── Field glossary table ────────────────────────────────────────────── */
    .glossary-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .glossary-table th {
      text-align: left; font-size: 11px; font-weight: 700;
      color: var(--text-secondary); text-transform: uppercase; letter-spacing: .04em;
      padding: 8px 12px; border-bottom: 2px solid var(--border);
      background: var(--bg);
    }
    .glossary-table td {
      padding: 10px 12px; border-bottom: 1px solid var(--border);
      vertical-align: top; font-size: 12px;
    }
    .glossary-table tr:last-child td { border-bottom: none; }
    .glossary-table tr:hover td { background: #faf9f8; }
    .glossary-table .field-name {
      font-family: 'Cascadia Code', 'Consolas', monospace;
      font-size: 11px;
      color: var(--primary-dark);
      white-space: nowrap;
    }
    .glossary-table .field-label { font-weight: 600; font-size: 12px; }
    .glossary-table .field-desc  { color: var(--text-secondary); margin-top: 2px; }

    /* ── Badges ──────────────────────────────────────────────────────────── */
    .badge {
      display: inline-block; padding: 2px 8px;
      border-radius: 10px; font-size: 11px; font-weight: 600;
    }
    .badge-required  { background: var(--error-border);   color: #6b0c0e; }
    .badge-optional  { background: var(--border);         color: var(--text-secondary); }
    .badge-info      { background: #dce9f8;               color: #004578; }
    .badge-warning   { background: var(--warning-border); color: #4d3700; }
    .badge-critical  { background: var(--error-border);   color: #6b0c0e; }
    .badge-success   { background: var(--success-border); color: #0e5a0e; }

    /* ── Env var table ───────────────────────────────────────────────────── */
    .env-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .env-table th {
      text-align: left; font-size: 11px; font-weight: 700;
      color: var(--text-secondary); text-transform: uppercase; letter-spacing: .04em;
      padding: 8px 12px; border-bottom: 2px solid var(--border);
      background: var(--bg);
    }
    .env-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: top; font-size: 12px; }
    .env-table tr:last-child td { border-bottom: none; }
    .env-table tr:hover td { background: #faf9f8; }
    .schema-name {
      font-family: 'Cascadia Code', 'Consolas', monospace;
      font-size: 11px; color: var(--primary-dark);
    }

    /* ── Code blocks ─────────────────────────────────────────────────────── */
    .code-block {
      background: #1e1e1e; color: #d4d4d4;
      border-radius: var(--radius);
      padding: 14px 16px;
      font-family: 'Cascadia Code', 'Consolas', monospace;
      font-size: 12px;
      line-height: 1.6;
      overflow-x: auto;
      margin: 10px 0;
    }
    .code-block .kw  { color: #569cd6; }
    .code-block .str { color: #ce9178; }
    .code-block .cmt { color: #6a9955; }
    .code-block .fn  { color: #dcdcaa; }

    code {
      font-family: 'Cascadia Code', 'Consolas', monospace;
      font-size: 12px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 1px 5px;
      color: var(--primary-dark);
    }

    /* ── Alert callouts ──────────────────────────────────────────────────── */
    .callout {
      display: flex; gap: 12px; align-items: flex-start;
      padding: 12px 16px;
      border-radius: var(--radius);
      margin: 12px 0;
      font-size: 12px;
    }
    .callout-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }
    .callout-info    { background: var(--primary-light); border: 1px solid #b0d0ef; }
    .callout-warning { background: var(--warning-light); border: 1px solid var(--warning-border); }
    .callout-tip     { background: var(--success-light); border: 1px solid var(--success-border); }

    /* ── Quick Start modal overlay ───────────────────────────────────────── */
    .qs-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,.45);
      display: flex; align-items: center; justify-content: center;
      z-index: 1000;
    }
    .qs-modal {
      background: var(--surface);
      border-radius: 6px;
      box-shadow: 0 8px 32px rgba(0,0,0,.28);
      width: 560px; max-width: 95vw;
      max-height: 90vh;
      overflow-y: auto;
      animation: qs-in .2s ease;
    }
    @keyframes qs-in { from { transform: translateY(-20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .qs-header {
      background: var(--primary); color: #fff;
      padding: 20px 24px 16px;
      border-radius: 6px 6px 0 0;
    }
    .qs-header h2 { font-size: 18px; font-weight: 700; }
    .qs-header p  { font-size: 12px; opacity: .85; margin-top: 4px; }

    .qs-body { padding: 20px 24px; }
    .qs-steps { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
    .qs-step {
      display: flex; gap: 14px; align-items: flex-start;
      padding: 12px 14px;
      background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius);
    }
    .qs-num {
      width: 24px; height: 24px; flex-shrink: 0;
      background: var(--primary); color: #fff; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 700;
    }
    .qs-step-title { font-weight: 600; font-size: 13px; }
    .qs-step-desc  { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }

    .qs-footer {
      padding: 14px 24px 20px;
      display: flex; justify-content: space-between; align-items: center;
      border-top: 1px solid var(--border);
    }
    .qs-footer label { font-size: 12px; color: var(--text-secondary); display: flex; align-items: center; gap: 6px; cursor: pointer; }

    /* ── Buttons ─────────────────────────────────────────────────────────── */
    .btn {
      display: inline-flex; align-items: center; gap: 5px;
      height: 32px; padding: 0 16px;
      border: none; border-radius: var(--radius);
      font-family: inherit; font-size: 13px; font-weight: 600;
      cursor: pointer; white-space: nowrap;
      transition: background .1s, opacity .1s;
    }
    .btn-primary   { background: var(--primary); color: #fff; }
    .btn-primary:hover { background: var(--primary-dark); }
    .btn-secondary { background: transparent; color: var(--primary); border: 1px solid var(--primary); }
    .btn-secondary:hover { background: var(--primary-light); }
    .btn-sm { height: 26px; padding: 0 10px; font-size: 12px; }

    /* ── Flow diagram ────────────────────────────────────────────────────── */
    .flow-diagram {
      display: flex; flex-direction: column; gap: 0;
      padding: 16px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius);
    }
    .flow-node {
      display: flex; align-items: center; gap: 12px;
      padding: 10px 14px;
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      font-size: 12px;
    }
    .flow-node-icon { font-size: 16px; flex-shrink: 0; }
    .flow-node-name { font-weight: 600; }
    .flow-node-desc { color: var(--text-secondary); font-size: 11px; margin-top: 1px; }
    .flow-arrow {
      width: 2px; height: 20px; background: var(--border-strong);
      margin-left: 22px; flex-shrink: 0;
      position: relative;
    }
    .flow-arrow::after {
      content: ''; position: absolute; bottom: -5px; left: -4px;
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      border-top: 6px solid var(--border-strong);
    }

    /* ── Responsive ──────────────────────────────────────────────────────── */
    @media (max-width: 740px) {
      .sidebar { display: none; }
      .app-main { padding: 16px; }
    }
  </style>
</head>
